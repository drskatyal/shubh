# Copy to .env locally. Never commit real values.
# EAS: eas secret:create --name GEMINI_API_KEY --type string

GEMINI_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_SHUBH_DEV_UNLOCK=0

# TathaAstu — key NEVER EXPO_PUBLIC, never in app extra / the binary.
# Run the proxy with the key, point the app at the proxy origin.
TATHAASTU_API_KEY=
TATHAASTU_PROXY_URL=http://127.0.0.1:8787
