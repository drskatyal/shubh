# Copy to .env locally. Never commit real values.
# App boots with every value empty: glance uses on-device Drik,
# Ask / matching / live almanac show a calm “connect later” state.

# --- Server / EAS secrets only. Never EXPO_PUBLIC_. Never in the app binary. ---
# eas secret:create --name DIVINE_API_KEY --type string
# eas secret:create --name DIVINE_API_TOKEN --type string
# eas secret:create --name GEMINI_API_KEY --type string
DIVINE_API_KEY=
# Optional. Only if Divine issued a Bearer token separate from the API key.
# Proxy uses DIVINE_API_KEY as Bearer when this is blank.
DIVINE_API_TOKEN=
GEMINI_API_KEY=

# --- Public URLs and store keys. Safe in Expo extra. Still never commit secrets. ---
# eas secret:create --name EXPO_PUBLIC_DIVINE_PROXY_URL --type string
# eas secret:create --name EXPO_PUBLIC_ASK_PROXY_URL --type string
# eas secret:create --name EXPO_PUBLIC_REVENUECAT_API_KEY --type string
DIVINE_PROXY_URL=
EXPO_PUBLIC_DIVINE_PROXY_URL=
ASK_PROXY_URL=
EXPO_PUBLIC_ASK_PROXY_URL=
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Dev unlock only. Must be 0 on store builds.
# eas secret:create --name EXPO_PUBLIC_SHUBH_DEV_UNLOCK --type string
EXPO_PUBLIC_SHUBH_DEV_UNLOCK=0

# Proxy process (server/divine-proxy.mjs). Not shipped in the binary.
DIVINE_PROXY_PORT=8787
