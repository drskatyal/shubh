# Copy to .env locally. Never commit real values.
# EAS: eas secret:create --name GEMINI_API_KEY --type string

GEMINI_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_SHUBH_DEV_UNLOCK=0

# Server / EAS secret only. Never EXPO_PUBLIC_. Never commit a real key.
# One key is enough: the proxy uses it as both api_key and Bearer token.
DIVINE_API_KEY=

# Optional. Only set if Divine issued a Bearer token separate from the API key.
DIVINE_API_TOKEN=

# App talks to this thin forwarder. The key stays on the server.
# EXPO_PUBLIC_ is allowed for the URL only, not the key.
DIVINE_PROXY_URL=
EXPO_PUBLIC_DIVINE_PROXY_URL=
